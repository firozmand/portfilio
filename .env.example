# Required for the admin area. Use a pooled PostgreSQL URL in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required only for the admin area and database seeding.
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Required only when uploading images or resumes on Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
